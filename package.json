{
  "name": "jobboard-pro",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @jobboard/web dev",
    "dev:api": "pnpm --filter @jobboard/api dev",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @jobboard/api prisma:generate",
    "db:migrate": "pnpm --filter @jobboard/api prisma:migrate",
    "db:seed": "pnpm --filter @jobboard/api prisma:seed",
    "db:studio": "pnpm --filter @jobboard/api prisma:studio"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
